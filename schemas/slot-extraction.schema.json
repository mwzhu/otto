{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otto.local/schemas/slot-extraction.schema.json",
  "title": "SlotExtraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["slot_updates", "claims", "tool_calls", "contradiction_signals"],
  "properties": {
    "slot_updates": {
      "type": "array",
      "items": { "$ref": "slot-state.schema.json" }
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "claim.schema.json" }
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "arguments"],
        "properties": {
          "name": { "type": "string" },
          "arguments": { "type": "object" }
        }
      }
    },
    "contradiction_signals": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
