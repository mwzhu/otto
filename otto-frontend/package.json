{
  "name": "otto-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "../scripts/with-env.sh .env.local -- next dev",
    "build": "if [ -d ../schemas ]; then mkdir -p schemas && cp ../schemas/*.json schemas/; fi && if [ -x ../scripts/with-env.sh ]; then ../scripts/with-env.sh .env.local -- next build; else next build; fi",
    "start": "../scripts/with-env.sh .env.local -- next start",
    "lint": "eslint",
    "test": "../scripts/with-env.sh .env.local -- vitest run tests/phase0 tests/phase1",
    "eval:director:smoke": "OTTO_EVAL_REPORT_PATH=eval-reports/director.jsonl vitest run tests/phase1/director-evals.test.ts tests/phase1/week3-director-document.test.ts tests/phase1/livekit-adapter.test.ts tests/phase1/service-auth.test.ts && cd ../agents/director && UV_CACHE_DIR=${UV_CACHE_DIR:-/tmp/otto-uv-cache} uv run --no-sync python -m director_agent.schema_contract && UV_CACHE_DIR=${UV_CACHE_DIR:-/tmp/otto-uv-cache} uv run --no-sync python -m unittest discover -s tests",
    "eval:operator": "OTTO_EVAL_REPORT_PATH=eval-reports/operator.jsonl vitest run tests/phase2/operator-graph-validation.test.ts tests/phase2/operator-workflow-eval.test.ts tests/phase2/operator-semantic-workflow-eval.test.ts tests/phase2/operator-conversation-quality.test.ts tests/phase2/opportunity-agent.test.ts",
    "eval:corrections": "OTTO_EVAL_REPORT_PATH=eval-reports/corrections.jsonl vitest run tests/phase1/correction-eval-fixtures.test.ts",
    "eval:cache:live": "OTTO_RUN_LIVE_CACHE_TEST=true vitest run tests/phase1/prompt-cache-live.test.ts",
    "verify:voice-telemetry": "node scripts/verify-voice-phrase-telemetry.cjs",
    "eval:all": "npm run eval:director:smoke && npm run eval:operator && npm run eval:corrections",
    "eval:director:container": "cd .. && docker build -f agents/director/Dockerfile -t otto-director-agent .",
    "db:generate": "../scripts/with-env.sh .env.local -- drizzle-kit generate",
    "db:migrate": "../scripts/with-env.sh .env.local -- drizzle-kit migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1051.0",
    "@aws-sdk/s3-request-presigner": "^3.1051.0",
    "@livekit/components-react": "^2.9.21",
    "@neondatabase/serverless": "^1.1.0",
    "@tiptap/react": "^3.23.5",
    "@tiptap/starter-kit": "^3.23.5",
    "@workos-inc/node": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "elkjs": "^0.11.1",
    "framer-motion": "^12.39.0",
    "inngest": "^4.4.0",
    "livekit-client": "^2.19.0",
    "livekit-server-sdk": "^2.15.3",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "pg": "^8.21.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.0.2",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.0",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
