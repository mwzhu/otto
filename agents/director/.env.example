LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="..."
LIVEKIT_API_SECRET="..."
LIVEKIT_AGENT_NAME="otto-director"
LIVEKIT_OPERATOR_AGENT_NAME="otto-operator"

OTTO_INTERNAL_API_BASE_URL="http://localhost:3000"
LIVEKIT_AGENT_SERVICE_TOKEN="replace-with-same-token-as-next"
DATABASE_SERVICE_URL="postgres://service_user:password@host/db?sslmode=require"
OTTO_CAPTURE_SESSION_ID=""
OTTO_DIRECTOR_LANGUAGE="en"
OTTO_DIRECTOR_PLANNER_RUNTIME="next"
# planned_cascade keeps the existing synchronous speech path.
# steered_cascade speaks from fast steering context and extracts structured notes async.
OTTO_DIRECTOR_VOICE_RUNTIME="planned_cascade"

ANTHROPIC_API_KEY="..."
DIRECTOR_BRAIN_MODEL="claude-sonnet-4-6"
DIRECTOR_VOICE_MODEL="claude-sonnet-4-6"

# Choose one provider mode. Direct provider mode is the default.
OTTO_USE_LIVEKIT_INFERENCE="false"
DEEPGRAM_API_KEY="..."
DEEPGRAM_MODEL="nova-3"
CARTESIA_API_KEY="..."
CARTESIA_MODEL="sonic-2"
CARTESIA_VOICE_ID="f786b574-daa5-4673-aa0c-cbe3e8534c02"

# Local endpointing fallback. Enable semantic turn detection only when the
# LiveKit turn-detector inference executor is available.
OTTO_USE_SEMANTIC_TURN_DETECTOR="false"
OTTO_DIRECTOR_ENDPOINTING_MODE="dynamic"
OTTO_DIRECTOR_ENDPOINTING_MIN_DELAY="1.45"
OTTO_DIRECTOR_ENDPOINTING_MAX_DELAY="3.0"
OTTO_DIRECTOR_ENDPOINTING_ALPHA="0.9"
OTTO_DIRECTOR_INTERRUPTION_MODE="vad"
OTTO_DIRECTOR_INTERRUPTION_MIN_DURATION="0.2"

# Set all strict flags to true only after the vendor/privacy review is complete.
OTTO_DIRECTOR_PREFLIGHT_STRICT="false"
OTTO_OPERATOR_PREFLIGHT_STRICT="false"
OTTO_VENDOR_PRIVACY_ACK="false"
OTTO_DEEPGRAM_NO_STORE_ACK="false"
OTTO_CARTESIA_NO_RETENTION_ACK="false"
OTTO_ANTHROPIC_RAW_LOGGING_OFF_ACK="false"
