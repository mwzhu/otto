# Shared local environment values live in ../../.env.local.
# Copy ../../.env.example to ../../.env.local, then add only operator-specific
# overrides here when they need to differ from the shared root values.
LIVEKIT_OPERATOR_AGENT_NAME="otto-operator"
# The director worker defaults to LiveKit's production health port 8081.
LIVEKIT_OPERATOR_WORKER_HTTP_PORT="8082"

OTTO_OPERATOR_LANGUAGE="en"

OTTO_OPERATOR_VOICE_RUNTIME="planned_cascade"
OTTO_OPERATOR_USE_SEPARATE_VOICE_LLM="false"
