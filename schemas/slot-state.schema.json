{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otto.local/schemas/slot-state.schema.json",
  "title": "SlotState",
  "type": "object",
  "additionalProperties": false,
  "required": ["slot_path", "status", "confidence", "evidence_ids", "priority"],
  "properties": {
    "slot_path": { "type": "string", "minLength": 1 },
    "candidate_process_id": { "type": "string", "format": "uuid" },
    "value": {},
    "status": {
      "type": "string",
      "enum": ["empty", "partial", "filled", "asked_unknown", "conflicting", "pending_re_extract"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "last_asked_at": { "type": "string", "format": "date-time" },
    "priority": { "type": "integer", "minimum": 0 },
    "candidates": { "type": "array" }
  }
}
