# Shared local environment values live in ../../.env.local.
# Copy ../../.env.example to ../../.env.local, then add only director-specific
# overrides here when they need to differ from the shared root values.
LIVEKIT_AGENT_NAME="otto-director"
LIVEKIT_OPERATOR_AGENT_NAME="otto-operator"

OTTO_CAPTURE_SESSION_ID=""
OTTO_DIRECTOR_LANGUAGE="en"
OTTO_DIRECTOR_PLANNER_RUNTIME="next"
# steered_cascade speaks from fast steering context and extracts Operations Notes async.
OTTO_DIRECTOR_VOICE_RUNTIME="steered_cascade"

# Local endpointing fallback. Enable semantic turn detection only when the
# LiveKit turn-detector inference executor is available.
OTTO_USE_SEMANTIC_TURN_DETECTOR="false"
OTTO_DIRECTOR_ENDPOINTING_MODE="dynamic"
OTTO_DIRECTOR_ENDPOINTING_MIN_DELAY="1.45"
OTTO_DIRECTOR_ENDPOINTING_MAX_DELAY="3.0"
OTTO_DIRECTOR_ENDPOINTING_ALPHA="0.9"
OTTO_DIRECTOR_INTERRUPTION_MODE="vad"
OTTO_DIRECTOR_INTERRUPTION_MIN_DURATION="0.2"
