LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="..."
LIVEKIT_API_SECRET="..."
LIVEKIT_AGENT_NAME="otto-director"

OTTO_INTERNAL_API_BASE_URL="http://localhost:3000"
LIVEKIT_AGENT_SERVICE_TOKEN="replace-with-same-token-as-next"
DATABASE_SERVICE_URL="postgres://service_user:password@host/db?sslmode=require"
OTTO_CAPTURE_SESSION_ID=""
OTTO_DIRECTOR_LANGUAGE="en"
OTTO_DIRECTOR_PLANNER_RUNTIME="python"

ANTHROPIC_API_KEY="..."
DIRECTOR_BRAIN_MODEL="claude-haiku-4-5"
DIRECTOR_VOICE_MODEL="claude-sonnet-4-6"

# Choose one provider mode. Direct provider mode is the default.
OTTO_USE_LIVEKIT_INFERENCE="false"
DEEPGRAM_API_KEY="..."
DEEPGRAM_MODEL="nova-3"
CARTESIA_API_KEY="..."
CARTESIA_MODEL="sonic-2"
CARTESIA_VOICE_ID="f786b574-daa5-4673-aa0c-cbe3e8534c02"

# Set all strict flags to true only after the vendor/privacy review is complete.
OTTO_DIRECTOR_PREFLIGHT_STRICT="false"
OTTO_VENDOR_PRIVACY_ACK="false"
OTTO_DEEPGRAM_NO_STORE_ACK="false"
OTTO_CARTESIA_NO_RETENTION_ACK="false"
OTTO_ANTHROPIC_RAW_LOGGING_OFF_ACK="false"
