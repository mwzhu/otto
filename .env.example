DATABASE_URL="postgres://user:password@host/db?sslmode=require"
# Service role must bypass RLS; used by cross-org jobs and voice service lookups.
DATABASE_SERVICE_URL="postgres://service_user:password@host/db?sslmode=require"

WORKOS_API_KEY="sk_test_..."
WORKOS_CLIENT_ID="client_..."
WORKOS_REDIRECT_URI="http://localhost:3000/api/auth/callback"
WORKOS_COOKIE_PASSWORD="replace-with-at-least-32-random-characters"

R2_ACCOUNT_ID="..."
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET="otto-dev"
R2_PUBLIC_BASE_URL="https://assets.example.com"

INNGEST_EVENT_KEY="..."
INNGEST_SIGNING_KEY="..."

ANTHROPIC_API_KEY="..."
DIRECTOR_BRAIN_MODEL="claude-sonnet-4-6"
DIRECTOR_VOICE_MODEL="claude-haiku-4-5-20251001"
OPERATOR_BRAIN_MODEL="claude-sonnet-4-6"
OPERATOR_VOICE_MODEL="claude-haiku-4-5-20251001"
OPERATOR_WORKFLOW_MODEL="claude-sonnet-4-6"
SYNTHESIS_PLANNER_MODEL="claude-opus-4-7"
OPPORTUNITY_AGENT_ENABLED="true"
DIRECTOR_AUTOMATION_PLAN_GENERATION_ENABLED="false"
VOYAGE_API_KEY="..."
OPENAI_API_KEY="..."

LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="..."
LIVEKIT_API_SECRET="..."
LIVEKIT_AGENT_NAME="otto-director"
LIVEKIT_OPERATOR_AGENT_NAME="otto-operator"
LIVEKIT_AGENT_SERVICE_TOKEN="replace-with-shared-worker-token"
OTTO_INTERNAL_API_BASE_URL="http://localhost:3000"

# Either use LiveKit Inference for STT/TTS providers or direct provider keys.
OTTO_USE_LIVEKIT_INFERENCE="false"
DEEPGRAM_API_KEY="..."
DEEPGRAM_MODEL="nova-3"
CARTESIA_API_KEY="..."
CARTESIA_MODEL="sonic-2"
CARTESIA_VOICE_ID="f786b574-daa5-4673-aa0c-cbe3e8534c02"

OTTO_DIRECTOR_PLANNER_RUNTIME="next"
OTTO_DIRECTOR_VOICE_RUNTIME="steered_cascade"
OTTO_OPERATOR_VOICE_RUNTIME="planned_cascade"
OTTO_OPERATOR_USE_SEPARATE_VOICE_LLM="false"
OTTO_OPERATOR_ALLOW_DETERMINISTIC_WORKFLOW_FALLBACK="false"

# Required for strict/full-production voice mode.
OTTO_DIRECTOR_PREFLIGHT_STRICT="false"
OTTO_OPERATOR_PREFLIGHT_STRICT="false"
OTTO_VENDOR_PRIVACY_ACK="false"
OTTO_DEEPGRAM_NO_STORE_ACK="false"
OTTO_CARTESIA_NO_RETENTION_ACK="false"
OTTO_ANTHROPIC_RAW_LOGGING_OFF_ACK="false"

# Local-only. The app refuses to start in production with this enabled.
OTTO_DEV_AUTH_BYPASS="true"
